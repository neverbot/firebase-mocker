{
  "name": "firebase-mocker",
  "version": "2.0.0",
  "description": "A modern TypeScript-based Firestore emulator server for local development and testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "NODE_ENV=test npx c8 mocha",
    "test:only": "NODE_ENV=test npx mocha",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix .",
    "lint:quiet": "npx eslint . --quiet"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "keywords": [
    "firebase",
    "firestore",
    "emulator",
    "mock",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neverbot/firebase-mocker.git"
  },
  "bugs": {
    "url": "https://github.com/neverbot/firebase-mocker/issues"
  },
  "homepage": "https://github.com/neverbot/firebase-mocker#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google-cloud/storage": "7.21.0",
    "@grpc/grpc-js": "1.14.4",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.9.2",
    "@types/protobufjs": "^6.0.0",
    "@types/winston": "^2.4.4",
    "c8": "11.0.0",
    "chai": "^6.2.2",
    "eslint": "10.4.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "firebase": "^12.14.0",
    "firebase-admin": "14.0.0",
    "globals": "17.6.0",
    "mocha": "11.7.6",
    "prettier": "3.8.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "express": "^5.2.1",
    "protobufjs": "^8.6.2",
    "winston": "^3.19.0"
  }
}
